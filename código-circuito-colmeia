bool systemClockIsValid() {
  // 01/01/2024 00:00:00 UTC. Evita aceitar o horário padrão de 1970.
  return time(nullptr) >= 1704067200;
}

void formatMeasurementTime(time_t timestamp) {
  time_t localTimestamp = timestamp + GMT_OFFSET_SECONDS;
  struct tm localTime;
  gmtime_r(&localTimestamp, &localTime);

  char buffer[24];
  strftime(buffer, sizeof(buffer), "%d/%m/%Y %H:%M:%S", &localTime);
  measurementTimeLocal = String(buffer);
}

bool captureMeasurementTimeFromClock() {
  if (!systemClockIsValid()) {
    measurementUnixS = 0;
    measurementTimeLocal = "";
    return false;
  }

  time_t currentUnixS = time(nullptr);
  unsigned long elapsedAfterMeasurementMs = millis() - measurementUptimeMs;
  measurementUnixS =
    currentUnixS - (time_t)((elapsedAfterMeasurementMs + 500UL) / 1000UL);

  formatMeasurementTime(measurementUnixS);
  return true;
}

bool synchronizeMeasurementTime() {
  if (WiFi.status() != WL_CONNECTED) {
    return false;
  }

  Serial.println("Sincronizando horário pela internet...");

  configTime(
    GMT_OFFSET_SECONDS,
    DAYLIGHT_OFFSET_SECONDS,
    NTP_SERVER_1,
    NTP_SERVER_2
  );

  unsigned long start = millis();

  while (!systemClockIsValid() &&
         millis() - start < NTP_SYNC_TIMEOUT_MS) {
    delay(250);
  }

  if (!systemClockIsValid()) {
    measurementUnixS = 0;
    measurementTimeLocal = "";
    Serial.println("Não foi possível obter o horário neste ciclo.");
    return false;
  }

  // As medições são feitas antes de ligar o Wi-Fi. A função desconta o tempo
  // transcorrido desde o fim das leituras.
  captureMeasurementTimeFromClock();

  Serial.print("Horário da medição: ");
  Serial.print(measurementTimeLocal);
  Serial.println(" (UTC-3)");

  return true;
}


