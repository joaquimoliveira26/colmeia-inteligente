void readBattery() {
  Serial.println("Lendo bateria...");

  const int samples = 30;
  uint32_t sumMv = 0;

  for (int i = 0; i < samples; i++) {
    sumMv += analogReadMilliVolts(PIN_BATTERY);
    delay(5);
  }

  float nodeV = (sumMv / (float)samples) / 1000.0;

  batteryV = nodeV * BATTERY_DIVIDER_FACTOR * BATTERY_CALIBRATION;

  batteryPct = 100.0 * (batteryV - BATTERY_EMPTY_V) /
               (BATTERY_FULL_V - BATTERY_EMPTY_V);

  batteryPct = clampFloat(batteryPct, 0.0, 100.0);

  Serial.print("Bateria: ");
  Serial.print(batteryV, 3);
  Serial.print(" V | ");
  Serial.print(batteryPct, 1);
  Serial.println(" % estimado");
}


