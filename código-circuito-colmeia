// 11. FIREBASE AUTH
// =======================================================

bool firebaseSignIn() {
  if (WiFi.status() != WL_CONNECTED) return false;

  HTTPClient http;
  http.setConnectTimeout(FIREBASE_TIMEOUT_MS);
  http.setTimeout(FIREBASE_TIMEOUT_MS);

  String url = "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key=";
  url += FIREBASE_API_KEY;

  if (!http.begin(secureClient, url)) {
    Serial.println("Erro ao iniciar HTTPS para login Firebase.");
    return false;
  }

  http.addHeader("Content-Type", "application/json");

  String body = "{";
  body += "\"email\":\"" + jsonEscape(FIREBASE_USER_EMAIL) + "\",";
  body += "\"password\":\"" + jsonEscape(FIREBASE_USER_PASSWORD) + "\",";
  body += "\"returnSecureToken\":true";
  body += "}";

  int code = http.POST(body);
  String response = http.getString();
  http.end();

  if (code < 200 || code >= 300) {
    Serial.print("Falha no login Firebase. HTTP ");
    Serial.println(code);
    Serial.println(response);
    return false;
  }

  DynamicJsonDocument doc(4096);
  DeserializationError err = deserializeJson(doc, response);

  if (err) {
    Serial.print("Erro ao interpretar login Firebase: ");
    Serial.println(err.c_str());
    return false;
  }

  firebaseIdToken = doc["idToken"].as<String>();

  if (firebaseIdToken.length() == 0) {
    Serial.println("Login Firebase não retornou idToken.");
    return false;
  }

  Serial.println("Login Firebase OK.");
  return true;
}


// =======================================================
// 12. FIREBASE DATABASE
// =======================================================

bool firebaseRequest(const String& method, const String& path, const String& jsonBody) {
  if (WiFi.status() != WL_CONNECTED) return false;

  if (firebaseIdToken.length() == 0) {
    if (!firebaseSignIn()) return false;
  }

  HTTPClient http;
  http.setConnectTimeout(FIREBASE_TIMEOUT_MS);
  http.setTimeout(FIREBASE_TIMEOUT_MS);

  String url = String(FIREBASE_DATABASE_URL);
  url += path;
  url += ".json?auth=";
  url += firebaseIdToken;

  if (!http.begin(secureClient, url)) {
    Serial.println("Erro ao iniciar HTTPS para Database.");
    return false;
  }

  http.addHeader("Content-Type", "application/json");

  int code = -1;

  if (method == "POST") {
    code = http.POST(jsonBody);
  } else if (method == "PUT") {
    code = http.PUT(jsonBody);
  } else if (method == "PATCH") {
    code = http.sendRequest("PATCH", jsonBody);
  } else {
    Serial.println("Método HTTP não suportado.");
    http.end();
    return false;
  }

  String response = http.getString();
  http.end();

  if (code >= 200 && code < 300) {
    Serial.print("Firebase ");
    Serial.print(method);
    Serial.print(" OK. HTTP ");
    Serial.println(code);
    return true;
  }

  Serial.print("Erro Firebase ");
  Serial.print(method);
  Serial.print(". HTTP ");
  Serial.println(code);
  Serial.println(response);

  return false;
}

bool firebasePost(const String& path, const String& jsonBody) {
  return firebaseRequest("POST", path, jsonBody);
}

bool firebasePut(const String& path, const String& jsonBody) {
  return firebaseRequest("PUT", path, jsonBody);
}

bool firebasePatch(const String& path, const String& jsonBody) {
  return firebaseRequest("PATCH", path, jsonBody);
}


