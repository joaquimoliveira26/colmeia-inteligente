uint32_t calculateReadingChecksum(const StoredReading& source) {
  StoredReading reading = source;
  reading.checksum = 0;

  const uint8_t* bytes = reinterpret_cast<const uint8_t*>(&reading);
  uint32_t hash = 2166136261UL;

  for (size_t i = 0; i < sizeof(StoredReading); i++) {
    hash ^= bytes[i];
    hash *= 16777619UL;
  }

  return hash;
}

bool storedReadingIsValid(const StoredReading& reading) {
  if (reading.magic != STORED_READING_MAGIC) return false;
  if (reading.formatVersion != STORED_READING_FORMAT_VERSION) return false;
  if (reading.recordSize != sizeof(StoredReading)) return false;
  return reading.checksum == calculateReadingChecksum(reading);
}

bool initializeLocalStorage() {
  Serial.println("Inicializando armazenamento local...");

  // O parâmetro true formata somente quando a montagem inicial falha. Isso é
  // necessário na primeira utilização da partição LittleFS.
  if (!LittleFS.begin(true)) {
    Serial.println("Falha ao montar LittleFS. A fila local não está disponível.");
    return false;
  }

  // Recuperação após eventual interrupção de energia durante a reescrita.
  if (!LittleFS.exists(QUEUE_FILE) && LittleFS.exists(QUEUE_BACKUP_FILE)) {
    LittleFS.rename(QUEUE_BACKUP_FILE, QUEUE_FILE);
  }

  if (LittleFS.exists(QUEUE_FILE) && LittleFS.exists(QUEUE_BACKUP_FILE)) {
    LittleFS.remove(QUEUE_BACKUP_FILE);
  }

  if (LittleFS.exists(QUEUE_TEMP_FILE)) {
    LittleFS.remove(QUEUE_TEMP_FILE);
  }

  Serial.println("LittleFS pronto.");
  return true;
}

size_t storedReadingCount() {
  if (!localStorageReady || !LittleFS.exists(QUEUE_FILE)) {
    return 0;
  }

  File file = LittleFS.open(QUEUE_FILE, FILE_READ);
  if (!file) return 0;

  size_t count = file.size() / sizeof(StoredReading);
  file.close();
  return count;
}

bool removeFirstRawRecords(size_t recordsToRemove) {
  if (!localStorageReady || recordsToRemove == 0) return true;
  if (!LittleFS.exists(QUEUE_FILE)) return true;

  File source = LittleFS.open(QUEUE_FILE, FILE_READ);
  if (!source) {
    Serial.println("Não foi possível abrir a fila para remoção.");
    return false;
  }

  size_t sourceSize = source.size();
  size_t bytesToSkip = recordsToRemove * sizeof(StoredReading);

  // Também elimina uma eventual cauda incompleta, que não constitui registro.
  if (bytesToSkip >= sourceSize ||
      sourceSize - bytesToSkip < sizeof(StoredReading)) {
    source.close();
    LittleFS.remove(QUEUE_FILE);
    LittleFS.remove(QUEUE_TEMP_FILE);
    LittleFS.remove(QUEUE_BACKUP_FILE);
    return true;
  }

  LittleFS.remove(QUEUE_TEMP_FILE);
  File destination = LittleFS.open(QUEUE_TEMP_FILE, FILE_WRITE);

  if (!destination || !source.seek(bytesToSkip)) {
    Serial.println("Falha ao preparar a atualização da fila local.");
    if (destination) destination.close();
    source.close();
    LittleFS.remove(QUEUE_TEMP_FILE);
    return false;
  }

  uint8_t buffer[256];

  while (source.available()) {
    size_t bytesRead = source.read(buffer, sizeof(buffer));
    if (bytesRead == 0) break;

    if (destination.write(buffer, bytesRead) != bytesRead) {
      Serial.println("Falha ao reescrever a fila local.");
      destination.close();
      source.close();
      LittleFS.remove(QUEUE_TEMP_FILE);
      return false;
    }
  }

  destination.flush();
  destination.close();
  source.close();

  LittleFS.remove(QUEUE_BACKUP_FILE);

  if (!LittleFS.rename(QUEUE_FILE, QUEUE_BACKUP_FILE)) {
    Serial.println("Falha ao criar backup temporário da fila.");
    LittleFS.remove(QUEUE_TEMP_FILE);
    return false;
  }

  if (!LittleFS.rename(QUEUE_TEMP_FILE, QUEUE_FILE)) {
    Serial.println("Falha ao substituir a fila; restaurando backup.");
    LittleFS.rename(QUEUE_BACKUP_FILE, QUEUE_FILE);
    LittleFS.remove(QUEUE_TEMP_FILE);
    return false;
  }

  LittleFS.remove(QUEUE_BACKUP_FILE);
  return true;
}

