String int64ToString(int64_t value) {
  char buffer[24];
  snprintf(buffer, sizeof(buffer), "%lld", (long long)value);
  return String(buffer);
}

String storedReadingKey(const StoredReading& reading) {
  char buffer[24];
  snprintf(
    buffer,
    sizeof(buffer),
    "m_%08lx%08lx",
    (unsigned long)reading.idHigh,
    (unsigned long)reading.idLow
  );
  return String(buffer);
}

String storedReadingTimeLocal(const StoredReading& reading) {
  if (!reading.measurementTimeValid || reading.measurementUnixS <= 0) {
    return "";
  }

  time_t localTimestamp =
    (time_t)reading.measurementUnixS + GMT_OFFSET_SECONDS;
  struct tm localTime;
  gmtime_r(&localTimestamp, &localTime);

  char buffer[24];
  strftime(buffer, sizeof(buffer), "%d/%m/%Y %H:%M:%S", &localTime);
  return String(buffer);
}

String buildStoredReadingJson(const StoredReading& reading) {
  String json;
  json.reserve(1000);
  json = "{";

  json += "\"id_medicao_local\":\"";
  json += storedReadingKey(reading);
  json += "\",";
  json += "\"tempo_ativo_ms\":" + String(reading.awakeUptimeMs) + ",";
  json += "\"timestamp_servidor\":{\".sv\":\"timestamp\"},";

  String localTime = storedReadingTimeLocal(reading);

  if (reading.measurementTimeValid &&
      reading.measurementUnixS > 0 &&
      localTime.length() > 0) {
    json += "\"horario_medicao_unix_s\":";
    json += int64ToString(reading.measurementUnixS);
    json += ",";
    json += "\"horario_medicao_local\":\"";
    json += jsonEscape(localTime);
    json += "\",";
  } else {
    json += "\"horario_medicao_unix_s\":null,";
    json += "\"horario_medicao_local\":null,";
  }

  json += "\"fuso_horario_medicao\":\"UTC-03:00\",";
  json += "\"contagem_inicializacoes\":" + String(reading.bootNumber) + ",";
  json += "\"causa_despertar\":\"";
  json += storedWakeupCauseText(reading.wakeupCause);
  json += "\",";

  json += "\"id_colmeia\":\"" + jsonEscape(HIVE_ID) + "\",";
  json += "\"tensao_bateria_v\":" + numberOrNull(reading.batteryV, 3) + ",";
  json += "\"carga_bateria_pct_estimada\":" + numberOrNull(reading.batteryPct, 1) + ",";

  json += "\"temperatura_externa_c\":" + numberOrNull(reading.externalTempC, 1) + ",";
  json += "\"umidade_externa_pct\":" + numberOrNull(reading.externalHumPct, 1) + ",";
  json += "\"temperatura_interna_c\":" + numberOrNull(reading.internalTempC, 1) + ",";
  json += "\"umidade_interna_pct\":" + numberOrNull(reading.internalHumPct, 1) + ",";

  json += "\"leitura_bruta_mc38\":" + String((int)reading.mc38Raw) + ",";
  json += "\"tampa_aberta\":";
  json += reading.lidOpen ? "true" : "false";
  json += ",";

  json += "\"audio_rms\":" + numberOrNull(reading.audioRms, 6) + ",";
  json += "\"audio_dbfs\":" + numberOrNull(reading.audioDbfs, 1) + ",";
  json += "\"audio_cruzamentos_zero_hz\":" + numberOrNull(reading.audioZeroCrossHz, 1) + ",";
  json += "\"amostras_audio_utilizadas\":" + String(reading.audioSamplesUsed) + ",";

  if (WiFi.status() == WL_CONNECTED) {
    json += "\"sinal_wifi_no_envio_rssi_dbm\":" + String(WiFi.RSSI()) + ",";
  } else {
    json += "\"sinal_wifi_no_envio_rssi_dbm\":null,";
  }

  json += "\"intervalo_coleta_s\":" + String(reading.sleepIntervalSeconds) + ",";
  json += "\"intervalo_envio_s\":" + String((uint32_t)UPLOAD_INTERVAL_SECONDS) + ",";
  json += "\"hora_inicio_envios_local\":" + String(UPLOAD_WINDOW_START_HOUR) + ",";
  json += "\"hora_ultimo_envio_local\":" + String(UPLOAD_WINDOW_LAST_HOUR) + ",";
  json += "\"intervalo_sono_tampa_aberta_s\":" + String(reading.lidOpenSleepSeconds) + ",";
  json += "\"janela_audio_ms\":" + String(reading.audioWindowMs) + ",";
  json += "\"taxa_amostragem_audio_hz\":" + String(reading.audioSampleRateHz) + ",";
  json += "\"armazenamento_local\":\"LittleFS\",";

  String storedFirmwareVersion = String(reading.firmwareVersion);
  String storedFirmwareId = "esp32_colmeia_deepsleep_firebase_v";
  storedFirmwareId += storedFirmwareVersion;
  storedFirmwareId.replace(".", "_");

  json += "\"firmware\":\"" + jsonEscape(storedFirmwareId) + "\",";
  json += "\"versao_firmware\":\"";
  json += jsonEscape(storedFirmwareVersion);
  json += "\"";
  json += "}";

  return json;
}

bool buildNextQueuedBatch(
  String& payload,
  size_t& validReadings,
  size_t& rawRecordsConsumed,
  StoredReading& lastValidReading
) {
  validReadings = 0;
  rawRecordsConsumed = 0;
  payload = "{";
  payload.reserve(READINGS_PER_FIREBASE_BATCH * 1000 + 2);

  if (!localStorageReady || !LittleFS.exists(QUEUE_FILE)) {
    payload += "}";
    return false;
  }

  File file = LittleFS.open(QUEUE_FILE, FILE_READ);
  if (!file) {
    payload += "}";
    return false;
  }

  while (file.available() >= (int)sizeof(StoredReading) &&
         validReadings < READINGS_PER_FIREBASE_BATCH) {
    StoredReading reading;
    size_t bytesRead = file.read(
      reinterpret_cast<uint8_t*>(&reading),
      sizeof(StoredReading)
    );

    if (bytesRead != sizeof(StoredReading)) break;
    rawRecordsConsumed++;

    if (!storedReadingIsValid(reading)) {
      Serial.println("Registro local inválido ignorado.");
      continue;
    }

    if (validReadings > 0) payload += ",";

    payload += "\"";
    payload += storedReadingKey(reading);
    payload += "\":";
    payload += buildStoredReadingJson(reading);

    lastValidReading = reading;
    validReadings++;
  }

  file.close();
  payload += "}";
  return rawRecordsConsumed > 0;
}

bool uploadSingleReadingDirectly(const StoredReading& reading) {
  String key = storedReadingKey(reading);
  String readingJson = buildStoredReadingJson(reading);
  String batchPayload = "{\"" + key + "\":" + readingJson + "}";

  String basePath = "/hives/" + String(HIVE_ID);
  bool readingsOk = firebasePatch(basePath + "/readings", batchPayload);

  if (readingsOk) {
    firebasePut(basePath + "/latest", readingJson);
  }

  return readingsOk;
}

bool uploadQueuedReadings() {
  if (!localStorageReady) {
    Serial.println("Fila local indisponível.");
    return false;
  }

  size_t initialCount = storedReadingCount();
  Serial.print("Enviando fila periódica. Medições pendentes: ");
  Serial.println(initialCount);

  if (initialCount == 0) {
    return true;
  }

  String basePath = "/hives/" + String(HIVE_ID);
  String readingsPath = basePath + "/readings";
  String latestPath = basePath + "/latest";

  while (storedReadingCount() > 0) {
    String batchPayload;
    size_t validReadings = 0;
    size_t rawRecordsConsumed = 0;
    StoredReading lastValidReading = {};

    bool hasRawRecords = buildNextQueuedBatch(
      batchPayload,
      validReadings,
      rawRecordsConsumed,
      lastValidReading
    );

    if (!hasRawRecords) {
      // Resta apenas uma cauda incompleta no arquivo.
      Serial.println("Removendo cauda incompleta da fila local.");
      LittleFS.remove(QUEUE_FILE);
      break;
    }

    if (validReadings == 0) {
      if (!removeFirstRawRecords(rawRecordsConsumed)) return false;
      continue;
    }

    Serial.print("Enviando lote com ");
    Serial.print(validReadings);
    Serial.println(" medição(ões)...");

    if (!firebasePatch(readingsPath, batchPayload)) {
      Serial.println("Lote mantido na flash para a próxima tentativa diurna.");
      return false;
    }

    // A leitura principal já está segura no Firebase. Uma falha ao atualizar
    // /latest não impede a remoção do lote, pois não deve criar duplicatas.
    String latestJson = buildStoredReadingJson(lastValidReading);
    if (!firebasePut(latestPath, latestJson)) {
      Serial.println("Aviso: histórico enviado, mas /latest não foi atualizado.");
    }

    if (!removeFirstRawRecords(rawRecordsConsumed)) {
      Serial.println("O lote foi enviado, mas permaneceu na fila local.");
      Serial.println("Na próxima tentativa ele será reenviado com as mesmas chaves, sem duplicação.");
      return false;
    }
  }

  Serial.println("Todas as medições pendentes foram enviadas.");
  return true;
}

bool uploadLidEvent(const StoredReading& reading) {
  if (reading.wakeupCause != WAKEUP_LID) return true;

  String eventJson = "{";
  eventJson += "\"timestamp_servidor\":{\".sv\":\"timestamp\"},";
  eventJson += "\"id_medicao_local\":\"" + storedReadingKey(reading) + "\",";
  eventJson += "\"contagem_inicializacoes\":" + String(reading.bootNumber) + ",";
  eventJson += "\"id_colmeia\":\"" + jsonEscape(HIVE_ID) + "\",";
  eventJson += "\"evento\":\"despertar_por_tampa\",";
  eventJson += "\"tampa_aberta\":";
  eventJson += reading.lidOpen ? "true" : "false";
  eventJson += ",";
  eventJson += "\"leitura_bruta_mc38\":" + String((int)reading.mc38Raw);
  eventJson += "}";

  String path = "/hives/" + String(HIVE_ID) + "/events/lid";
  bool ok = firebasePost(path, eventJson);

  if (ok) {
    Serial.println("Evento de abertura da tampa enviado imediatamente.");
  } else {
    Serial.println("Falha no evento imediato; a medição permanece na fila local.");
  }

  return ok;
}


// =======================================================
// 18. DEEP SLEEP
// =======================================================

void goToSleep() {
  Serial.println("Preparando deep sleep...");

  shutdownI2S();
  shutdownWiFi();

  // Acordar por tempo.
  // Se a tampa estiver aberta, reduzimos temporariamente o sono para acompanhar
  // o evento sem criar um ciclo de acordar imediatamente pelo EXT0.
  uint64_t sleepSeconds = lidOpen ? LID_OPEN_SLEEP_SECONDS : SLEEP_INTERVAL_SECONDS;
  lastPlannedSleepSeconds = (uint32_t)sleepSeconds;
  esp_sleep_enable_timer_wakeup(sleepSeconds * 1000000ULL);

  // Acordar por abertura da tampa.
  if (ENABLE_LID_WAKEUP) {
    // Reconfigura GPIO27 como RTC GPIO.
    rtc_gpio_init((gpio_num_t)PIN_MC38);
    rtc_gpio_set_direction((gpio_num_t)PIN_MC38, RTC_GPIO_MODE_INPUT_ONLY);

    // Como o MC-38 está ligado ao GND, usamos pull-up interno.
    // Isso mantém o pino em HIGH quando o contato está aberto.
    rtc_gpio_pullup_en((gpio_num_t)PIN_MC38);
    rtc_gpio_pulldown_dis((gpio_num_t)PIN_MC38);

    // Necessário quando se depende dos resistores internos RTC durante deep sleep.
    esp_sleep_pd_config(ESP_PD_DOMAIN_RTC_PERIPH, ESP_PD_OPTION_ON);

    // Evita ciclo infinito:
    // se a tampa já estiver aberta no momento de dormir, o ESP32 acordaria
    // imediatamente de novo. Nesse caso, neste ciclo ele dorme apenas por tempo.
    if (!lidOpen) {
      esp_sleep_enable_ext0_wakeup((gpio_num_t)PIN_MC38, LID_OPEN_LEVEL);
      Serial.println("Wake-up por tampa habilitado.");
    } else {
      Serial.println("Tampa já aberta. Wake-up por tampa desabilitado neste ciclo para evitar loop.");
    }
  }

  Serial.print("Dormindo por até ");
  Serial.print((unsigned long)sleepSeconds);
  Serial.println(" s, ou até abertura da tampa.");

  Serial.flush();
  delay(200);

  esp_deep_sleep_start();
}


// =======================================================
// 19. SETUP
// =======================================================

void setup() {
  Serial.begin(115200);
  delay(1000);

  initializeRtcState();
  accountForLastSleep();
  bootCount++;

  Serial.println();
  Serial.println("=======================================");
  Serial.println("Sistema de monitoramento da colmeia");
  Serial.println("Modo: coleta a cada 10 min + envio diurno a cada 2 h");
  Serial.print("Versao do firmware: ");
  Serial.println(FIRMWARE_VERSION);
  Serial.println("=======================================");

  Serial.print("Boot count: ");
  Serial.println(bootCount);

  Serial.print("Causa do despertar: ");
  Serial.println(wakeupCauseText());

  localStorageReady = initializeLocalStorage();
  if (localStorageReady) {
    Serial.print("Medições pendentes no início do ciclo: ");
    Serial.println(storedReadingCount());
  }

  // Para protótipo: simplifica HTTPS sem validar certificado raiz.
  // Para versão final, o ideal é configurar o certificado raiz.
  secureClient.setInsecure();

  // O GPIO27 é colocado no domínio RTC antes do deep sleep. Depois de
  // qualquer reinicialização, devolvemos explicitamente o pino ao GPIO digital.
  rtc_gpio_deinit((gpio_num_t)PIN_MC38);
  pinMode(PIN_MC38, INPUT_PULLUP);

  analogReadResolution(12);
  analogSetPinAttenuation(PIN_BATTERY, ADC_11db);

  dht1.begin();
  dht2.begin();

  delay(1500);

  readLidSensor();
  readBattery();
  readDHTSensors();

  if (setupI2S()) {
    readAudioFeatures();
  } else {
    Serial.println("Áudio não foi medido neste ciclo.");
  }

  // Marca o fim do conjunto de medições. O horário absoluto será calculado
  // pelo relógio RTC ou, nos ciclos de envio, após a sincronização NTP.
  measurementUptimeMs = millis();
  captureMeasurementTimeFromClock();

  bool periodicCheckDue = periodicUploadIsDue();
  bool lidWakeup =
    esp_sleep_get_wakeup_cause() == ESP_SLEEP_WAKEUP_EXT0;

  bool clockKnown = systemClockIsValid();
  bool uploadWindowOpen =
    clockKnown && uploadWindowIsOpen(time(nullptr));

  // Um despertar pela tampa só é transmitido imediatamente durante o dia.
  // Fora da janela, a própria medição registra a causa e fica na fila local.
  bool lidEventAllowed = lidWakeup && uploadWindowOpen;
  bool lidNeedsTimeCheck = lidWakeup && !clockKnown;

  bool periodicUploadDue = periodicCheckDue && uploadWindowOpen;
  bool wifiNeeded =
    periodicCheckDue || lidEventAllowed || lidNeedsTimeCheck;
  bool wifiConnected = false;

  if (periodicCheckDue && !clockKnown) {
    Serial.println("Horário ainda desconhecido: Wi-Fi será ligado para consultar o NTP.");
  } else if (periodicUploadDue) {
    Serial.println("Chegou o momento da tentativa de envio a cada 2 horas.");
  } else if (lidEventAllowed) {
    Serial.println("Wi-Fi será ligado para o evento diurno da tampa.");
  } else if (lidWakeup) {
    Serial.println("Evento noturno da tampa: será armazenado, sem envio imediato.");
  } else if (clockKnown && !uploadWindowOpen) {
    Serial.println("Fora da janela diurna: Wi-Fi permanecerá desligado.");
  } else {
    Serial.println("Coleta intermediária: Wi-Fi permanecerá desligado.");
  }

  if (wifiNeeded) {
    wifiConnected = connectWiFi();

    if (wifiConnected) {
      synchronizeMeasurementTime();

      if (systemClockIsValid()) {
        time_t nowUtc = time(nullptr);
        uploadWindowOpen = uploadWindowIsOpen(nowUtc);

        // Reavalia depois do NTP. Isso impede qualquer acesso ao Firebase
        // durante a madrugada, inclusive após ligar ou reiniciar o ESP32.
        periodicUploadDue =
          uploadWindowOpen &&
          (nextPeriodicUploadUnixS <= 0 ||
           (int64_t)nowUtc >= nextPeriodicUploadUnixS);

        lidEventAllowed = lidWakeup && uploadWindowOpen;

        if (!uploadWindowOpen) {
          Serial.println("Janela de envio fechada. Dados preservados até as 06h.");

          // Se a agenda ainda não existia ou ficou no passado, programa 06h
          // sem fazer uma requisição ao Firebase.
          if (nextPeriodicUploadUnixS <= 0 ||
              (int64_t)nowUtc >= nextPeriodicUploadUnixS) {
            markPeriodicUploadAttempt();
          }
        }
      } else {
        periodicUploadDue = false;
        lidEventAllowed = false;
        Serial.println("Horário não confirmado: Firebase não será acessado neste ciclo.");
      }
    }
  }

  StoredReading currentReading = captureCurrentReading();
  bool currentStored = appendStoredReading(currentReading);

  if (!currentStored) {
    Serial.println("Aviso: a medição atual não pôde ser preservada na flash.");
  }

  if (wifiConnected) {
    if (lidEventAllowed) {
      uploadLidEvent(currentReading);
    }

    if (periodicUploadDue) {
      if (currentStored) {
        uploadQueuedReadings();
      } else {
        Serial.println("Tentando enviar diretamente a medição não armazenada.");
        uploadSingleReadingDirectly(currentReading);
      }
    }
  } else if (wifiNeeded) {
    if (currentStored) {
      Serial.println("Sem Wi-Fi. Os dados permanecem na flash para uma tentativa futura.");
    } else {
      Serial.println("Sem Wi-Fi e sem fila local: a medição atual não poderá ser recuperada.");
    }
  }

  // Uma falha não provoca novas tentativas a cada 10 minutos, o que anularia
  // a economia de energia. A fila será tentada no próximo horário diurno.
  if (periodicUploadDue) {
    markPeriodicUploadAttempt();
  } else if (periodicCheckDue && !systemClockIsValid()) {
    // Sem NTP, ainda não é possível saber se é madrugada. Espera duas horas
    // antes de tentar consultar o horário novamente.
    markPeriodicUploadAttempt();
  }

  goToSleep();
}


// =======================================================
// 20. LOOP
// =======================================================
//
// No modelo com deep sleep, o loop fica vazio.
// O ESP32 reinicia o setup() a cada despertar.

void loop() {
}
