String jsonEscape(const String& s) {
  String out = "";
  for (size_t i = 0; i < s.length(); i++) {
    char c = s[i];

    if (c == '\\') out += "\\\\";
    else if (c == '"') out += "\\\"";
    else if (c == '\n') out += "\\n";
    else if (c == '\r') out += "\\r";
    else if (c == '\t') out += "\\t";
    else out += c;
  }

  return out;
}

String numberOrNull(float value, int digits) {
  if (isnan(value) || isinf(value)) return "null";
  return String(value, digits);
}

float clampFloat(float x, float a, float b) {
  if (x < a) return a;
  if (x > b) return b;
  return x;
}

