bool setupI2S() {
  i2sStarted = false;
  i2sRxChannel = nullptr;

  i2s_chan_config_t channelConfig =
    I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_0, I2S_ROLE_MASTER);

  channelConfig.dma_desc_num = 4;
  channelConfig.dma_frame_num = 512;

  esp_err_t err = i2s_new_channel(
    &channelConfig,
    nullptr,
    &i2sRxChannel
  );

  if (err != ESP_OK) {
    Serial.print("Erro ao criar canal RX I2S: ");
    Serial.println(err);
    i2sRxChannel = nullptr;
    return false;
  }

  i2s_std_config_t standardConfig = {
    .clk_cfg = I2S_STD_CLK_DEFAULT_CONFIG(AUDIO_SAMPLE_RATE_HZ),
    .slot_cfg = I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(
      I2S_DATA_BIT_WIDTH_32BIT,
      I2S_SLOT_MODE_MONO
    ),
    .gpio_cfg = {
      .mclk = I2S_GPIO_UNUSED,
      .bclk = (gpio_num_t)PIN_I2S_BCLK,
      .ws = (gpio_num_t)PIN_I2S_WS,
      .dout = I2S_GPIO_UNUSED,
      .din = (gpio_num_t)PIN_I2S_DOUT,
      .invert_flags = {
        .mclk_inv = false,
        .bclk_inv = false,
        .ws_inv = false
      }
    }
  };

  // O pino L/R do INMP441 está ligado ao GND, portanto usamos o canal esquerdo.
  standardConfig.slot_cfg.slot_mask = I2S_STD_SLOT_LEFT;

  err = i2s_channel_init_std_mode(i2sRxChannel, &standardConfig);
  if (err != ESP_OK) {
    Serial.print("Erro ao configurar modo padrão I2S: ");
    Serial.println(err);
    i2s_del_channel(i2sRxChannel);
    i2sRxChannel = nullptr;
    return false;
  }

  err = i2s_channel_enable(i2sRxChannel);
  if (err != ESP_OK) {
    Serial.print("Erro ao habilitar canal RX I2S: ");
    Serial.println(err);
    i2s_del_channel(i2sRxChannel);
    i2sRxChannel = nullptr;
    return false;
  }

  i2sStarted = true;

  Serial.println("I2S configurado com o driver atual.");
  return true;
}

void shutdownI2S() {
  if (i2sRxChannel != nullptr) {
    if (i2sStarted) {
      i2s_channel_disable(i2sRxChannel);
    }

    i2s_del_channel(i2sRxChannel);
    i2sRxChannel = nullptr;
    i2sStarted = false;
  }
}

void readAudioFeatures() {
  Serial.println("Lendo áudio do INMP441...");

  const int bufferSamples = 512;

  int32_t buffer[bufferSamples];
  size_t bytesRead = 0;

  unsigned long start = millis();

  double sumSamples = 0.0;
  double sumSquares = 0.0;
  int totalSamples = 0;
  int zeroCrossings = 0;
  int previousSign = 0;

  while (millis() - start < AUDIO_WINDOW_MS) {
    esp_err_t result = i2s_channel_read(
      i2sRxChannel,
      (void*)buffer,
      sizeof(buffer),
      &bytesRead,
      1000
    );

    if (result != ESP_OK || bytesRead == 0) {
      continue;
    }

    int samplesRead = bytesRead / sizeof(int32_t);

    for (int i = 0; i < samplesRead; i++) {
      int32_t sample24 = buffer[i] >> 8;

      double x = sample24 / 8388608.0;

      sumSamples += x;
      sumSquares += x * x;
      totalSamples++;

      int sign = 0;

      if (x > 0.0005) sign = 1;
      else if (x < -0.0005) sign = -1;

      if (sign != 0) {
        if (previousSign != 0 && sign != previousSign) {
          zeroCrossings++;
        }

        previousSign = sign;
      }
    }
  }

  if (totalSamples <= 0) {
    audioRms = NAN;
    audioDbfs = NAN;
    audioZeroCrossHz = NAN;
    audioSamplesUsed = 0;
    Serial.println("Falha na leitura de áudio.");
    return;
  }

  // Remove o deslocamento DC antes de calcular o RMS. Sem essa correção,
  // um pequeno offset do microfone seria interpretado como energia acústica.
  double mean = sumSamples / totalSamples;
  double variance = (sumSquares / totalSamples) - (mean * mean);

  // Protege contra um pequeno valor negativo causado por arredondamento.
  if (variance < 0.0) {
    variance = 0.0;
  }

  audioRms = sqrt(variance);

  if (audioRms > 0.0000001) {
    audioDbfs = 20.0 * log10(audioRms);
  } else {
    audioDbfs = -120.0;
  }

  float durationSec = totalSamples / (float)AUDIO_SAMPLE_RATE_HZ;

  // Indicador comparativo do sinal. Em sons complexos, cruzamentos de zero
  // não correspondem à frequência dominante (isso exigiria análise espectral).
  audioZeroCrossHz = (zeroCrossings / durationSec) / 2.0;
  audioSamplesUsed = totalSamples;

  Serial.print("Áudio RMS: ");
  Serial.print(audioRms, 6);
  Serial.print(" | dBFS: ");
  Serial.print(audioDbfs, 1);
  Serial.print(" | zeroCrossHz: ");
  Serial.println(audioZeroCrossHz, 1);
}


