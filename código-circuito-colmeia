  reading.measurementTimeValid = measurementUnixS > 0 ? 1 : 0;

  strncpy(
    reading.firmwareVersion,
    FIRMWARE_VERSION,
    sizeof(reading.firmwareVersion) - 1
  );
  reading.firmwareVersion[sizeof(reading.firmwareVersion) - 1] = '\0';

  reading.checksum = calculateReadingChecksum(reading);
  return reading;
}

bool appendStoredReading(const StoredReading& reading) {
  if (!localStorageReady) return false;

  size_t count = storedReadingCount();
  if (count >= MAX_STORED_READINGS) {
    size_t excess = count - MAX_STORED_READINGS + 1;
    Serial.println("Fila cheia. Removendo a medição mais antiga.");

    if (!removeFirstRawRecords(excess)) {
      return false;
    }
  }

  File file = LittleFS.open(QUEUE_FILE, FILE_APPEND);
  if (!file) {
    Serial.println("Falha ao abrir a fila para gravação.");
    return false;
  }

  size_t bytesWritten = file.write(
    reinterpret_cast<const uint8_t*>(&reading),
    sizeof(StoredReading)
  );

  file.flush();
  file.close();

  if (bytesWritten != sizeof(StoredReading)) {
    Serial.println("Falha ao gravar a medição completa na flash.");
    return false;
  }

  Serial.print("Medição armazenada. Itens na fila: ");
  Serial.println(storedReadingCount());
  return true;
}


