void accountForLastSleep() {
  if (esp_sleep_get_wakeup_cause() != ESP_SLEEP_WAKEUP_TIMER) {
    return;
  }

  uint64_t accumulated =
    (uint64_t)secondsSinceLastPeriodicAttempt + lastPlannedSleepSeconds;

  if (accumulated > 7ULL * 24ULL * 60ULL * 60ULL) {
    accumulated = 7ULL * 24ULL * 60ULL * 60ULL;
  }

  secondsSinceLastPeriodicAttempt = (uint32_t)accumulated;
}

bool getLocalTimeParts(time_t utcTimestamp, struct tm& localTime) {
  if (utcTimestamp < 1704067200) {
    return false;
  }

  time_t localTimestamp = utcTimestamp + GMT_OFFSET_SECONDS;
  gmtime_r(&localTimestamp, &localTime);
  return true;
}

bool uploadWindowIsOpen(time_t utcTimestamp) {
  struct tm localTime;
  if (!getLocalTimeParts(utcTimestamp, localTime)) {
    return false;
  }

  return localTime.tm_hour >= UPLOAD_WINDOW_START_HOUR &&
         localTime.tm_hour <= UPLOAD_WINDOW_LAST_HOUR;
}

int64_t calculateNextAllowedUploadUnixS(time_t nowUtc) {
  struct tm localTime;
  if (!getLocalTimeParts(nowUtc, localTime)) {
    return 0;
  }

  int secondsSinceLocalMidnight =
    localTime.tm_hour * 3600 + localTime.tm_min * 60 + localTime.tm_sec;

  // Início do dia local expresso como timestamp UTC.
  int64_t localDayStartUtc =
    (int64_t)nowUtc - (int64_t)secondsSinceLocalMidnight;

  // Antes das 06h, a próxima tentativa será às 06h do mesmo dia.
  if (localTime.tm_hour < UPLOAD_WINDOW_START_HOUR) {
    return localDayStartUtc +
           (int64_t)UPLOAD_WINDOW_START_HOUR * 3600LL;
  }

  // Depois do horário das 22h, a próxima tentativa será às 06h do dia
  // seguinte. A hora 22 é tratada abaixo como o último horário permitido.
  if (localTime.tm_hour > UPLOAD_WINDOW_LAST_HOUR) {
    return localDayStartUtc + 24LL * 3600LL +
           (int64_t)UPLOAD_WINDOW_START_HOUR * 3600LL;
  }

  // Dentro da janela diurna, alinha o próximo envio à grade
  // 06h, 08h, 10h, ..., 22h.
  int hoursAfterStart = localTime.tm_hour - UPLOAD_WINDOW_START_HOUR;
  int intervalHours = (int)(UPLOAD_INTERVAL_SECONDS / 3600ULL);
  int nextSlot = (hoursAfterStart / intervalHours) + 1;
  int nextHour = UPLOAD_WINDOW_START_HOUR + nextSlot * intervalHours;

  if (nextHour <= UPLOAD_WINDOW_LAST_HOUR) {
    return localDayStartUtc + (int64_t)nextHour * 3600LL;
  }

  return localDayStartUtc + 24LL * 3600LL +
         (int64_t)UPLOAD_WINDOW_START_HOUR * 3600LL;
}

bool periodicUploadIsDue() {
  if (systemClockIsValid()) {
    time_t nowUtc = time(nullptr);

    // Mesmo que exista uma fila pendente, o Firebase não é acessado fora da
    // janela de envio. Os registros permanecem preservados na flash.
    if (!uploadWindowIsOpen(nowUtc)) {
      return false;
    }

    if (nextPeriodicUploadUnixS <= 0) {
      return true;
    }

    return (int64_t)nowUtc >= nextPeriodicUploadUnixS;
  }

  // Ao ligar ou gravar um novo firmware, ainda não sabemos o horário. Ligamos
  // o Wi-Fi uma vez para consultar o NTP, mas só enviamos ao Firebase depois
  // de confirmar que estamos dentro da janela diurna.
  if (esp_sleep_get_wakeup_cause() == ESP_SLEEP_WAKEUP_UNDEFINED) {
    return true;
  }

  // Enquanto o NTP ainda não foi obtido, usa o tempo de sono acumulado como
  // plano B. Isso evita tentar ligar o Wi-Fi a cada coleta quando a rede cai.
  return secondsSinceLastPeriodicAttempt >= UPLOAD_INTERVAL_SECONDS;
}

void markPeriodicUploadAttempt() {
  secondsSinceLastPeriodicAttempt = 0;

  if (systemClockIsValid()) {
    nextPeriodicUploadUnixS =
      calculateNextAllowedUploadUnixS(time(nullptr));
  } else {
    nextPeriodicUploadUnixS = 0;
  }
}


